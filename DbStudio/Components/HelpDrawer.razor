<div class="help-shell">
    <div class="help-search">
        <Icon Name="search" />
        <input aria-label="搜索使用说明" placeholder="搜索功能或操作，例如：同步、外键、备份…" @bind="query" @bind:event="oninput" @bind:after="UpdateSearch" />
        @if (query != "")
        {
            <button class="icon-button" aria-label="清除搜索" @onclick='() => query = ""'><Icon Name="x-lg" /></button>
        }
    </div>

    <div class="help-layout">
        <nav class="help-nav" aria-label="使用说明目录">
            <span class="help-nav-label">说明目录</span>
            @foreach (var item in VisibleTopics)
            {
                <button class="@(active == item.Id ? "active" : "")" @onclick="() => Select(item.Id)">
                    <span>@item.Title</span><small>@item.Subtitle</small>
                </button>
            }
            @if (!VisibleTopics.Any())
            {
                <p>没有匹配的说明</p>
            }
        </nav>

        <article class="help-content" tabindex="-1" @key="active">
            @if (!VisibleTopics.Any())
            {
                <p>没有匹配的说明。试试“版本”“清空”或“权限”等关键词。</p>
            }
            else if (active == "start")
            {
                <HelpTitle Eyebrow="快速开始" Title="从项目到第一张表" Description="按下面的顺序完成一次设计；保存后才会进入项目修订、搜索和导出。" />
                <div class="help-steps">
                    <section><b>1</b><div><h4>选择项目</h4><p>在顶部选择项目。左侧按模块列出数据表；“项目首页”显示已保存的结构统计和最近活动。没有项目时，由有权限的成员点击左侧“创建项目”。</p></div></section>
                    <section><b>2</b><div><h4>创建并填写表</h4><p>点击左侧“新建表”，填写表名和业务名称；通过“新增字段”追加字段，填写字段名、定义名与类型，再按需要设置主键、默认值和备注。</p></div></section>
                    <section><b>3</b><div><h4>检查并保存</h4><p>点击“检查设计”查看问题，修正后点击“保存设计”（或 Ctrl+S）。保存成功会产生新的 r 修订；没有实际变化时不会增加修订。</p></div></section>
                </div>
                <HelpSection Title="认识三个区域">
                    <ul><li>顶部切换项目，进入“版本”“ER 图”“备份与导入”和“数据库工具”。</li><li>左侧搜索和打开表，管理模块，返回项目首页。</li><li>中间编辑当前表；“SQL 预览”查看当前表脚本，“变更记录”查看表的历史。</li></ul>
                </HelpSection>
                <HelpSection Title="快速找到字段">
                    <p>顶部“字段与引用快速检索”可搜索字段名、定义名、表名、模块、类型和备注。结果同时显示同名字段数量、引用目标及被引用次数；点击后直接打开表并定位字段。按 Ctrl+K 可随时聚焦检索框。</p>
                </HelpSection>
                <HelpNote Title="先保存，再离开">切换项目、表或刷新页面时，未保存的修改需要明确放弃。项目级 ER 图、版本比较、项目备份和结构归档以已保存设计为准；表内“关系图”可预览当前草稿。</HelpNote>
            }
            else if (active == "projects")
            {
                <HelpTitle Eyebrow="项目管理" Title="项目、模块与成员范围" Description="每个项目独立维护结构、成员、分享链接和数据库连接。" />
                <HelpSection Title="项目与模块">
                    <ul><li>点击顶部项目选择器切换项目；切换前先保存当前表。创建项目的成员会自动成为该项目管理员。</li><li>“项目设置 → 基本信息”可修改项目名称和说明。</li><li>“项目设置 → 模块管理”或左侧“新建 / 管理模块”可创建空模块、重命名模块；重命名会同步更新模块中的表。</li><li>左侧搜索按表名、业务名称或字段定位表；左下角“刷新项目”重新读取项目。</li></ul>
                </HelpSection>
                <HelpSection Title="访问范围">
                    <p>全局角色决定账号能力上限，项目成员身份决定能够访问哪些项目。两者同时生效。</p>
                    <div class="help-role-grid"><span><b>只读成员</b>浏览设计</span><span><b>设计成员</b>编辑与导出</span><span><b>数据库维护</b>使用数据库工具</span><span><b>项目管理员</b>管理项目全部功能</span></div>
                    <p>项目管理员在“项目设置 → 项目成员”中添加已有账号。全局只读账号即使被授予项目设计权限，也不能保存设计。</p>
                </HelpSection>
            }
            else if (active == "design")
            {
                <HelpTitle Eyebrow="结构设计" Title="字段、索引和约束" Description="编辑区中的变化先保存在当前草稿，点击保存后才形成新的项目修订。" />
                <HelpSection Title="字段编辑">
                    <ul><li>点击“新增字段”在表末尾追加字段；字段名、定义名和类型需完整填写，定义名不能只填空格。</li><li>勾选字段后可批量上移、下移、删除或复制。复制到另一张表后点“批量粘贴”；同名字段会自动加后缀，主键和自增需在目标表重新设置。</li><li>自增、计算列、排序规则等设置位于每行右侧的“高级设置”。复制计算列后需检查表达式引用。</li><li>点击字段备注进入大文本框；“应用”仅修改草稿，还需保存整张表。取消则不修改草稿。</li></ul>
                </HelpSection>
                <HelpSection Title="约束与 SQL">
                    <ul><li>在“索引”“表关系”和“检查约束”标签页维护表级规则。索引可设置唯一性、排序、包含列和过滤条件。</li><li>新建表关系默认为逻辑关系，只保留在设计、备份和归档中。需要 SQL Server 约束时，改为物理外键并检查目标键及参照动作。</li><li>“SQL 预览”可检查当前表生成的脚本；项目级 SQL 从顶部“备份与导入”下载，范围为全部已保存表。</li></ul>
                </HelpSection>
                <HelpSection Title="保存前后如何核对">
                    <p>先点“检查设计”，按提示修正字段和约束，再保存。若其他成员先保存了同一项目，刷新后核对差异再重做当前修改。保存设计只更新工作台模型，不会直接修改实际数据库。</p>
                </HelpSection>
                <HelpSection Title="ER 图">
                    <ul><li>从顶部或项目首页进入项目级 ER 图，先选择模块，再点击表卡片查看直接关联；在表设计页的“关系图”可直接查看当前表，并预览未保存草稿。</li><li>在“项目设置 → 技术字段”按字段名定义技术字段。ER 图默认隐藏它们及相关连线；勾选“显示技术字段及关系”可临时查看。</li><li>聚焦后可切换“本表引用”“被其他表引用”或“双向”。物理外键使用蓝绿色实线，逻辑关系使用紫色虚线；也可展开全部字段或显示模块全部连线。</li><li>滚轮缩放、拖动画布；聚焦一张表后，点击顶部按钮打开结构设计。</li></ul>
                </HelpSection>
                <HelpNote Title="设计检查不是数据库验证">表达式语义、级联路径以及目标数据库中的依赖，仍需在实际 SQL Server 环境中验证。</HelpNote>
            }
            else if (active == "database")
            {
                <HelpTitle Eyebrow="数据库工具" Title="反推、比对与结构同步" Description="入口：顶部“数据库工具 → 连接、反推与结构同步”。先明确要从数据库读取设计，还是把已保存设计同步到数据库。" />
                <HelpSection Title="1. 配置并测试连接">
                    <ol><li>项目管理员点击“新增连接”，填写连接名称、发布环境、服务器 / 实例、数据库及认证方式，保存后在“当前连接”中选中它。</li><li>点击“测试连接”，确认连接到预期的服务器和数据库。Windows 认证使用应用服务器运行账号；SQL 认证密码加密保存且不回显。</li><li>数据库维护成员可使用连接；只有项目管理员可编辑或删除配置。修改连接会使旧比对计划失效；删除配置不会删除实际数据库。</li></ol>
                </HelpSection>
                <HelpSection Title="2. 从实际数据库反推设计">
                    <ol><li>先为目标库准备备份，并确认账号具有读取结构所需的 VIEW DEFINITION 权限。</li><li>点击“读取结构并预览”。系统读取表、字段、主键、索引、物理外键、检查约束和说明，不读取业务数据。</li><li>在预览中检查每张表的差异并勾选要合并的表；数据库独有的表默认不选。设计中独有的表会保留。</li><li>点击“合并选中的表”后，所选结构直接保存到项目设计。核对字段和关系；遇到无法无损映射的特性时，先按页面提示处理，不能强行合并。</li></ol>
                </HelpSection>
                <HelpSection Title="3. 把设计与数据库比对">
                    <ol><li>先保存设计。开发环境可选择当前 r 或已有 V；测试、预发布、生产只能选择已有 V。</li><li>默认不勾选删除多余对象和解锁高风险 DDL。点击“开始比对”生成结构差异、警告和 SQL，此时尚未修改数据库。</li><li>核对页面显示的环境、服务器、数据库、范围、来源 r / V 和计划有效时间；逐项查看结构差异、高风险清单，并展开“查看完整同步脚本”。需要留档可点击“下载同步 SQL”。</li><li>若要删除库中多余对象，或处理删列、删表、容量收窄等风险，修改对应选项后必须重新比对，并重新审核整份脚本。</li></ol>
                </HelpSection>
                <HelpSection Title="4. 执行或登记版本">
                    <ol><li>完成目标库备份、脚本和警告核对后，勾选“我已核对目标、发布版本和同步脚本”，输入完整目标数据库名。</li><li>解锁高风险 DDL 时，还需输入页面显示的专项确认短语；生产环境另需输入含 V 号的发布确认短语。</li><li>点击“执行同步”。即使差异为零，也要点击“验证并登记”，系统重新完整校验后才记录该环境版本。</li><li>执行失败、取消、目标库被其他工具修改或计划过期后，重新比对并确认实际状态，再决定是否继续。</li></ol>
                </HelpSection>
                <HelpSection Title="计划与安全边界">
                    <ul><li>同步计划绑定成员、项目修订、连接版本和目标结构，有效期十五分钟；项目、连接或目标结构变化后必须重新比对。</li><li>默认保留实际库中设计未定义的对象，并阻止可能造成数据丢失的变更。解锁只解除预防性阻断；现有值无法转换时 SQL Server 仍会回滚并报错。</li><li>设计器不覆盖 SQL Server 的全部特性。视图、过程、账号等不属于设计器维护范围；反推预览中的不支持项需逐一核对。</li></ul>
                </HelpSection>
                <HelpNote Kind="warning" Title="执行前再次核对">确认备份、目标服务器、数据库名、发布版本和完整脚本。部署期间避免其他工具同时修改目标结构。单表结构同步只允许开发环境使用。</HelpNote>
            }
            else if (active == "versions")
            {
                <HelpTitle Eyebrow="版本与恢复" Title="设计修订 r 和发布版本 V" Description="顶部“版本”用于比较、恢复设计，并查看每个数据库连接的发布状态。" />
                <HelpSection Title="查看并比较设计历史">
                    <ol><li>每次实际保存设计生成新的 r 和完整项目快照；无变化的重复保存不会增加 r。</li><li>打开顶部“版本”，选择起始 r 和目标 r，检查表、字段、索引和关系差异。</li><li>需要恢复时，由项目管理员选择旧 r 并确认“恢复整个项目”。只恢复一张表则打开该表的“变更记录”。恢复会生成新的 r，不改写旧历史。</li></ol>
                </HelpSection>
                <HelpSection Title="按环境发布同一个 V">
                    <ul><li>开发环境可从当前 r 比对、同步；整库校验一致后生成或复用不可变 V。</li><li>测试、预发布、生产只能选已有 V。所有已配置的较低环境都须先完整验证同一个 V，才能向上推进。</li><li>版本页的环境矩阵显示每个连接最后成功同步的 r / V 和状态；它是历史记录，不能代替当前结构比对。</li></ul>
                </HelpSection>
                <HelpNote Title="设计恢复不等于数据库回滚">恢复只改变工作台中的设计。实际数据库的结构和数据不会自动回退；需要时从备份恢复，或重新比对后执行同步。</HelpNote>
            }
            else if (active == "cleanup")
            {
                <HelpTitle Eyebrow="数据清空" Title="生成并执行 TRUNCATE 计划" Description="此操作会永久清除选定表的数据。请先备份业务数据，并逐表核对范围。" />
                <HelpSection Title="选择清空范围">
                    <ol><li>从顶部“数据库工具”进入整库工具，选择当前连接及数据分类；也可从当前表进入单表比对页，只处理这张表。</li><li>点击“生成清空计划”。系统连接实际库，检查表和外键，列出将处理的表并生成事务 SQL。</li><li>逐表核对计划中的服务器、数据库、表、外键处理和完整脚本；需要留档可下载 TRUNCATE SQL。</li><li>完成备份后，勾选已核对范围并输入完整目标数据库名，点击“确认执行 TRUNCATE”。</li></ol>
                </HelpSection>
                <HelpSection Title="执行效果和限制">
                    <ul><li>TRUNCATE 清空数据并复位自增列，不删除表结构；脚本不会静默退回逐行 DELETE。</li><li>范围内的跨表外键会在同一事务内处理并重建；范围外表引用选中父表时，系统拒绝生成计划。</li><li>清空计划与当前项目和目标库状态绑定。计划失效、执行失败或取消后重新生成并核对。</li></ul>
                </HelpSection>
                <HelpNote Kind="warning" Title="不可撤销">确认执行后不能在工作台中撤销；只有事先准备的数据库备份可用于恢复数据。</HelpNote>
            }
            else if (active == "backup")
            {
                <HelpTitle Eyebrow="备份与输出" Title="SQL、JSON 与结构归档" Description="根据使用场景选择输出格式；所有项目级输出都以已保存设计为准。" />
                <div class="help-format-grid">
                    <section><span>SQL</span><h4>项目脚本</h4><p>用于审查或在 SQL Server 中建立结构，不会由下载操作自动执行。</p></section>
                    <section><span>JSON</span><h4>项目备份</h4><p>用于迁移设计；恢复时创建独立项目，不覆盖原项目。</p></section>
                    <section><span>PDF</span><h4>结构归档</h4><p>用于评审、归档和交付，包含目录、字段及约束信息。</p></section>
                </div>
                <HelpSection Title="如何导出与恢复">
                    <ol><li>先保存当前表，再打开顶部“备份与导入”。选择“项目 SQL 脚本”“项目备份（JSON）”或“结构归档（PDF）”。</li><li>SQL 脚本覆盖当前项目全部已保存表，可供审查或另行执行；下载本身不会修改数据库。</li><li>JSON 用于迁移设计。选择“导入项目备份”后先预览，再创建新项目；原项目不会被覆盖。导入上限为 10 MB、500 张表、10000 个字段。</li><li>PDF 需填写文档编号、版本、数据库名称、环境和编制人等资料，再生成归档；正文含字段、关系、索引和约束。</li></ol>
                </HelpSection>
                <HelpSection Title="备份不包含的内容">
                    <p>项目 JSON 不包含账号、成员、分享链接、数据库连接或密码。PDF 只包含设计器管理的结构，不包含视图、过程或实际业务数据。服务器完整备份还需妥善备份 App_Data 与数据保护密钥。</p>
                </HelpSection>
            }
            else if (active == "share")
            {
                <HelpTitle Eyebrow="协作查看" Title="免登录只读分享" Description="向无需编辑权限的查看者提供项目最新已保存结构。" />
                <HelpSection Title="创建与撤销">
                    <ol><li>先保存需要展示的设计，再打开“项目设置 → 只读分享”。</li><li>选择 7、30、90 天或长期有效，创建后复制链接给查看者。链接展示该项目最新已保存结构。</li><li>查看者无需登录，可搜索、切换表格 / 卡片视图并沿表关系跳转；不能编辑。</li><li>不再需要分享时，在同一设置中撤销。链接立即失效，但无法收回访问者已经保存的内容。</li></ol>
                </HelpSection>
                <HelpNote Title="对外访问">127.0.0.1 链接只能在服务器本机打开。外部访问需要完成部署并配置公开地址。</HelpNote>
            }
            else if (active == "members")
            {
                <HelpTitle Eyebrow="账号与权限" Title="成员、角色和密码" Description="权限由全局角色与项目成员权限共同决定。" />
                <HelpSection Title="日常管理">
                    <ol><li>有系统权限的管理员在顶部“权限管理”添加账号并设置全局角色。</li><li>项目管理员再到“项目设置 → 项目成员”把已有账号加入项目，并选择只读、设计、数据库维护或项目管理权限。</li><li>成员从右上角账号菜单选择“修改密码”；新密码至少 10 位，同时包含字母和数字。</li></ol>
                    <p>停用账号、变更角色或修改密码后，旧会话会失效。账号的全局角色和项目权限同时生效。</p>
                </HelpSection>
                <HelpNote Kind="warning" Title="最小权限原则">只为成员分配完成工作所需的权限。数据库连接维护、执行同步和公开分享应限定给明确负责人。</HelpNote>
            }
            else
            {
                <HelpTitle Eyebrow="常见问题" Title="遇到问题时先检查这些" Description="先确认保存状态、项目权限、目标连接和版本。" />
                <div class="help-faq">
                    <details open><summary>为什么导出的内容没有刚才的修改？</summary><p>项目备份、项目 SQL 和 PDF 归档只读取已保存设计。请先保存当前表，再重新导出。</p></details>
                    <details><summary>为什么看不到某个项目或功能？</summary><p>检查账号的全局角色以及该项目的成员权限。只读成员无法保存，普通成员默认看不到未分配的项目。</p></details>
                    <details><summary>为什么数据库同步计划失效？</summary><p>计划超过十五分钟，或项目、连接、目标结构发生变化后，需要重新比对，以保证执行内容仍与当前状态一致。</p></details>
                    <details><summary>为什么反推预览不能合并？</summary><p>先检查页面上的不支持特性警告、当前设计修订是否已变化，以及是否勾选了可合并的表。设计修订变化后需重新读取结构。</p></details>
                    <details><summary>为什么高风险 DDL 无法执行？</summary><p>查看高风险清单；需要先勾选“解锁高风险 DDL”重新比对，再核对完整脚本、备份和页面要求的确认短语。数据不兼容时 SQL Server 仍会拒绝执行。</p></details>
                    <details><summary>为什么测试或生产环境不能选当前 r？</summary><p>非开发环境只能选择开发环境整库校验产生的不可变 V。较低环境都通过同一 V 后，才能继续向上发布。</p></details>
                    <details><summary>误操作后可以直接撤销吗？</summary><p>未保存的设计可通过刷新放弃。已保存的内容可在“版本”中预览差异后恢复整个项目，或在表的“变更记录”中只恢复当前表。数据库中的数据与结构不会随设计恢复自动回退，仍需备份或后续同步。</p></details>
                </div>
            }
        </article>
    </div>
</div>

@code {
    [Parameter] public string InitialTopic { get; set; } = "start";

    private string query = "";
    private string active = "start";

    private static readonly Topic[] Topics =
    [
        new("start", "快速开始", "认识工作台", "开始 新建 表 保存 项目 首页 搜索 检索 字段 引用 同名 Ctrl K"),
        new("projects", "项目与模块", "组织与访问范围", "项目 模块 设置 成员 权限"),
        new("design", "结构设计", "字段、关系与 ER 图", "字段 索引 外键 逻辑关系 物理外键 ER 图 约束 备注 SQL 草稿 保存"),
        new("database", "数据库工具", "反推、比对与同步", "连接 服务器 认证 VIEW DEFINITION 反推 合并 比对 同步 SQL 高风险 DDL 删除 脚本"),
        new("versions", "版本与恢复", "r 修订、V 发布", "版本 修订 发布 r V 历史 恢复 环境 开发 测试 预发布 生产"),
        new("cleanup", "数据清空", "TRUNCATE 与范围", "清空 TRUNCATE 数据 分类 外键 自增 备份"),
        new("backup", "备份与归档", "SQL、JSON 与 PDF", "备份 导入 导出 SQL JSON PDF 归档"),
        new("share", "只读分享", "创建、访问与撤销", "分享 链接 匿名 撤销 外网"),
        new("members", "账号与权限", "成员、角色与密码", "账号 用户 角色 权限 密码 登录"),
        new("faq", "常见问题", "保存、权限与恢复", "问题 导出 失效 撤销 恢复 看不到"),
    ];

    private IEnumerable<Topic> VisibleTopics => string.IsNullOrWhiteSpace(query)
        ? Topics
        : Topics.Where(x => $"{x.Title} {x.Subtitle} {x.Keywords}".Contains(query.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        active = Topics.Any(x => x.Id == InitialTopic) ? InitialTopic : "start";
    }

    private void Select(string id)
    {
        active = id;
        query = "";
    }

    private void UpdateSearch()
    {
        var first = VisibleTopics.FirstOrDefault();
        if (first != null && !VisibleTopics.Any(x => x.Id == active)) active = first.Id;
    }

    private sealed record Topic(string Id, string Title, string Subtitle, string Keywords);
}
